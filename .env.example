APP_NAME=GBP Post Verification
DATABASE_URL=sqlite:///data/app.db
SCREENSHOT_DIR=screenshots
BROWSER_PROFILE_DIR=browser_profile
LOG_DIR=logs

DEFAULT_RETRY_INTERVAL_MINUTES=30
DEFAULT_MAX_RETRIES=3
AGENCY_NAME=Your Agency Name

GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
EMAIL_SUBJECT_TEMPLATE=Google Business Profile Post – {{date}}
EMAIL_TEMPLATE_FILE=templates/email_template.txt

# Keep false for first-time Google login and normal troubleshooting.
HEADLESS=false
BROWSER_TIMEOUT_SECONDS=45
MANUAL_LOGIN_TIMEOUT_MINUTES=10
